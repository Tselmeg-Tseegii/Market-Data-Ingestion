par(mfrow = c(2, 2))
compare <- function(old, new) {
old <- old[old <= 40000]
new <- new[new <= 40000]
cat("OLD\n")
cat("Mean:  ", mean(old), "\n")
cat("Median:", median(old), "\n")
cat("SD:    ", sd(old), "\n")
cat("NEW\n")
cat("Mean:  ", mean(new), "\n")
cat("Median:", median(new), "\n")
cat("SD:    ", sd(new), "\n")
maxOld = max(old)
maxNew = max(new)
maxAll = max(maxOld, maxNew)
hist(old, breaks = 1000, xlim = c(0, 40000))
plot(old, type = "p")
hist(new, breaks = 1000, xlim = c(0, 40000))
plot(new, type = "p")
}
